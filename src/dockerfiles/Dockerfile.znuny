#######################
# Image: CPAN-builder #
#######################

FROM debian:stable-slim AS builder

# NOTE: enable/disable optional znuny modules for faster compile time
RUN apt-get update && \
    apt-get upgrade -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      # Required - XML::LibXML links against it - Dependency for Net::SAML2
      libxml2-dev \
      # Required - all Crypt::OpenSSL::* modules need it - Dependency for Net::SAML2
      libssl-dev \
      # Required - LWP::Protocol::https / compression support - Dependency for Net::SAML2
      libnet-ssleay-perl \
      zlib1g-dev \
      # Required - Dependency for DBD::ODBC
      unixodbc-dev \
      # CPAN Installation
      build-essential \
      cpanminus && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN cpanm --notest --local-lib=/opt/perl5 \
    Jq \
    DBD::ODBC \
    Net::SAML2



#####################
# Image: Znuny-base #
#####################

FROM debian:stable-slim AS base

ARG ZNUNY_VERSION
ARG ZNUNY_CHECKSUM
ARG ZNUNY_SIGNATURE
ARG ZNUNY_USER=znuny
ARG ZNUNY_NodeID

ARG APACHE_USER=www-data

ENV ZNUNY_HOME=/opt/znuny \
    ZNUNY_STAGING=/opt/znuny-staging \
    ZNUNY_USER=${ZNUNY_USER} \
    ZNUNY_NodeID=${ZNUNY_NodeID} \
    PATH=$PATH:/opt/znuny/bin:/opt/perl5/bin \
    PERL5LIB=/opt/perl5/lib/perl5 \
    PERL_MM_USE_DEFAULT=1

# Download URLs and Destination Paths
ARG URL_FILE=https://download.znuny.org/releases/znuny-${ZNUNY_VERSION}.tar.gz
ARG URL_FILE_HASH=https://download.znuny.org/releases/znuny-${ZNUNY_VERSION}.tar.gz.sha256
ARG URL_FILE_KEY=https://download.znuny.org/releases/znuny-${ZNUNY_VERSION}.tar.gz.asc
ARG URL_FILE_RELEASE_KEY=https://download.znuny.org/znuny-release-key.asc

ARG ZNUNY_ARCHIVE_FILE=/tmp/znuny-${ZNUNY_VERSION}.tar.gz
ARG ZNUNY_ARCHIVE_FILE_HASH=/tmp/znuny-${ZNUNY_VERSION}.tar.gz.sha256
ARG ZNUNY_FILE_KEY=/tmp/znuny-${ZNUNY_VERSION}.tar.gz.asc
ARG ZNUNY_FILE_RELEASE_KEY=/tmp/znuny-release-key.asc

# Bash Colors
ARG RED='\033[0;31m'
ARG NC='\033[0m' # No Color

# Use bash instead of sh for some bash code
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install all required Perl modules
RUN apt-get update && \
    apt-get upgrade -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      libdbi-perl \
      libdbd-mysql-perl \
      libdata-uuid-perl \
      libapache-dbi-perl \
      libtimedate-perl \
      libnet-dns-perl \
      libnet-ldap-perl \
      libio-socket-ssl-perl \
      libpdf-api2-perl \
      libsoap-lite-perl \
      libtext-csv-xs-perl \
      libjson-xs-perl \
      libxml-libxml-perl \
      libxml-libxslt-perl \
      libyaml-perl \
      libarchive-zip-perl \
      libcrypt-eksblowfish-perl \
      libencode-hanextra-perl \
      libmail-imapclient-perl \
      libtemplate-perl \
      libdatetime-perl \
      libdatetime-timezone-perl \
      libdatetime-locale-perl \
      libmoo-perl \
      libyaml-libyaml-perl \
      libjavascript-minifier-xs-perl \
      libcss-minifier-xs-perl \
      libauthen-sasl-perl \
      libauthen-ntlm-perl \
      libdbd-pg-perl \
      libcrypt-jwt-perl \
      libcrypt-openssl-x509-perl \
      libhash-merge-perl \
      libical-parser-perl \
      libspreadsheet-xlsx-perl \
      # DBD::ODBC
      libxml2 \
      libssl3 \
      libnet-ssleay-perl \
      unixodbc \
      # Other packages
      # default-mysql-client = mariadb-client
      default-mysql-client \
      gosu \
      curl \
      gnupg \
      unzip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Perl Modules (built in the builder stage) and verify that they load.
COPY --from=builder /opt/perl5 /opt/perl5
# Verify
RUN perl -MData::UUID -e 'print "Data::UUID OK\n"' && \
    perl -MNet::SAML2 -e 'print "Net::SAML2 OK\n"' && \
    perl -DBD::ODBC -e 'print "DBD::ODBC OK\n"'

# Create Znuny user
RUN useradd -d ${ZNUNY_HOME} -c "Znuny user" -g ${APACHE_USER} -s /bin/bash -M -N ${ZNUNY_USER}

# Inject project files for setup and clean up
RUN mkdir -p ${ZNUNY_STAGING}
RUN chown ${ZNUNY_USER}:${APACHE_USER} ${ZNUNY_STAGING}

# Check if newest version already exists; when not, delete folder and recreate
# It does not delete content from symlinks
RUN set -eux; \
    FILE_RELEASE=${ZNUNY_STAGING}/RELEASE; \
    if [[ -f "${FILE_RELEASE}" ]]; then \
        source ${FILE_RELEASE}; \
        if [[ "${VERSION}" != "${ZNUNY_VERSION}" ]]; then \
            rm -r --no-dereference ${ZNUNY_STAGING}; \
            mkdir ${ZNUNY_STAGING}; \
        fi; \
    fi

# Download and import Znuny Release Key
RUN set -eux; \
    case "${ZNUNY_SIGNATURE,,}" in \
        false|0|no|off) \
            echo -e "${RED}Znuny Signature check is disabled${NC}" ;; \
        *) \
        if [ ! -f "${ZNUNY_FILE_RELEASE_KEY}" ]; then \
            echo "Downloading... ${URL_FILE_RELEASE_KEY}"; \
            curl -fsSL "${URL_FILE_RELEASE_KEY}" -o "${ZNUNY_FILE_RELEASE_KEY}"; \
        fi; \
        gpg --import ${ZNUNY_FILE_RELEASE_KEY} ;; \
    esac


# Download, verify and extract archive
RUN set -eux; \
    if [ ! -f "${ZNUNY_ARCHIVE_FILE}" ]; then \
        echo "Downloading... ${URL_FILE}"; \
        curl -fsSL "${URL_FILE}" -o "${ZNUNY_ARCHIVE_FILE}"; \
    fi; \
    #
    # Check Hash
    case "${ZNUNY_CHECKSUM,,}" in \
        false|0|no|off) \
            echo -e "${RED}Znuny Signature check is disabled${NC}";; \
        *) \
        #
        # Download Hash
        if [ ! -f "${ZNUNY_ARCHIVE_FILE_HASH}" ]; then \
            echo "Downloading... ${URL_FILE_HASH}"; \
            curl -fsSL "${URL_FILE_HASH}" -o "${ZNUNY_ARCHIVE_FILE_HASH}"; \
        fi; \
        #
        # Validate Download
        printf '%s  %s\n' "$(awk '{print $1}' "${ZNUNY_ARCHIVE_FILE_HASH}")" "${ZNUNY_ARCHIVE_FILE}" | sha256sum -c -;; \
    esac; \
    #
    # Check Signature
    case "${ZNUNY_SIGNATURE,,}" in \
        false|0|no|off) \
            echo -e "${RED}Znuny Signature check is disabled${NC}";; \
        *) \
        #
        # Download Key
        if [ ! -f "${ZNUNY_FILE_KEY}" ]; then \
            echo "Downloading... ${URL_FILE_KEY}"; \
            curl -fsSL "${URL_FILE_KEY}" -o "${ZNUNY_FILE_KEY}"; \
        fi; \
        #
        # Validate Key
        gpg --verify "${ZNUNY_FILE_KEY}" "${ZNUNY_ARCHIVE_FILE}";; \
    esac; \
    #
    # Removes the top-level folder during extraction
    tar -xzf "${ZNUNY_ARCHIVE_FILE}" --strip-components=1 -C "${ZNUNY_STAGING}"

# Set Working Directory
WORKDIR ${ZNUNY_HOME}

# docker-specific scripts
COPY ./docker-specific/znuny.sh /usr/local/bin/znuny.sh
COPY ./docker-specific/znuny_setup.sh /usr/local/bin/znuny_setup.sh
RUN chmod +x /usr/local/bin/znuny.sh /usr/local/bin/znuny_setup.sh


################
# Image: httpd #
################

FROM base AS httpd

ARG ZNUNY_DEFAULT_INTERFACE
ARG WEB_PORT

# Install Apache with Perl module
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      apache2 \
      libapache2-mod-perl2 \
      rsync && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Perl Modules
COPY --from=builder /opt/perl5 /opt/perl5
# Verify - Again
RUN perl -MData::UUID -e 'print "Data::UUID OK\n"' && \
    perl -Net::SAML2 -e 'print "Net::SAML2 OK\n"' && \
    perl -DBD::ODBC -e 'print "DBD::ODBC OK\n"'

# Perl Configuration
# Enable MySQL modules in Apache Perl startup
RUN sed -i 's/^#use DBD::mysql/use DBD::mysql/' "${ZNUNY_STAGING}/scripts/apache2-perl-startup.pl" && \
    sed -i 's/^#use Kernel::System::DB::mysql/use Kernel::System::DB::mysql/' "${ZNUNY_STAGING}/scripts/apache2-perl-startup.pl"

# Apache configuration
# TODO Accept User-Header (Single SignOn)
RUN a2dismod mpm_event && \
    a2enmod mpm_prefork perl headers deflate filter cgi rewrite && \
    echo "RedirectMatch ^/$ /znuny/index.pl" >> /etc/apache2/apache2.conf

ENV APACHE_RUN_USER=${APACHE_USER} \
    APACHE_RUN_GROUP=${APACHE_USER} \
    APACHE_RUN_DIR=/var/run/apache2 \
    APACHE_LOCK_DIR=/var/lock/apache2 \
    APACHE_LOG_DIR=/var/log/apache2 \
    APACHE_PID_FILE=/var/run/apache2/apache2.pid \
    WEB_PORT=${WEB_PORT} \
    ZNUNY_DEFAULT_INTERFACE=${ZNUNY_DEFAULT_INTERFACE}

RUN mkdir -p /var/run/apache2 /var/lock/apache2 /var/log/apache2 && \
    chown -R ${APACHE_USER}:${APACHE_USER} /var/run/apache2 /var/lock/apache2 /var/log/apache2

# Container-internal HTTP port (the external port is set with WEB_PORT in compose)
EXPOSE 80

# Setup Entry
COPY ./entrypoints/apache.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

COPY ./docker-specific/apache_starter.sh /usr/local/bin/apache_starter.sh
RUN chmod +x /usr/local/bin/apache_starter.sh
RUN chown ${APACHE_USER}: /usr/local/bin/apache_starter.sh

USER root
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/local/bin/apache_starter.sh"]



#################
# Image: daemon #
#################

FROM base AS daemon

# Setup Entrypoint
COPY ./entrypoints/daemon.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Watchdog Setup
COPY ./docker-specific/watchdog.sh /usr/local/bin/watchdog.sh
RUN chmod +x /usr/local/bin/watchdog.sh
RUN chown ${ZNUNY_USER}:${APACHE_USER} /usr/local/bin/watchdog.sh

USER root

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/local/bin/watchdog.sh"]
