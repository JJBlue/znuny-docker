# Znuny
ZNUNY_PERSISTENT_FOLDER=/opt/znuny
ZNUNY_CHECKSUM=false
ZNUNY_SIGNATURE=true
ZNUNY_VERSION=latest
ZNUNY_INSTANCE=default
ZNUNY_INSTANCE_NUMBER=0
ZNUNY_DEFAULT_INTERFACE=agent

# Database
DB_HOST=znuny-db
# TODO PORT
DB_PORT=3306
DB_NAME=znuny
DB_USER=znuny

# Database (docker-compose-db.yml)
MARIADB_VERSION=latest
DB_MEMLIMIT=2048m

# Apache (docker-compose.yml)
WEB_PORT=80